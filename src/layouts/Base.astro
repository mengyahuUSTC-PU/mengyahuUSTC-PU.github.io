---
import { SITE_TITLE, SITE_URL, t, type Lang } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Path of this page, e.g. "/en/my-post/" */
  path: string;
  /** Path of the same page in the other language, if it exists */
  altPath?: string;
}

const { title, description, lang, path, altPath } = Astro.props;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const canonical = new URL(path, SITE_URL).href;
---

<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@600;900&family=Source+Serif+4:opsz,wght@8..60,600..900&display=swap"
    />
    <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={canonical} />
    {altPath && (
      <link
        rel="alternate"
        hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'}
        href={new URL(altPath, SITE_URL).href}
      />
    )}
    {altPath && (
      <link rel="alternate" hreflang="x-default" href={new URL(lang === 'en' ? path : altPath, SITE_URL).href} />
    )}
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} (English)`} href="/en/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE}（中文）`} href="/zh/rss.xml" />
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6F7TVKDCGG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-6F7TVKDCGG');
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="band">
      <div class="container">
        <nav class="nav">
          <a class="brand" href={`/${lang}/`}>{SITE_TITLE}</a>
          <div class="nav-links">
            <a href={`/${lang}/`}>{t(lang, 'nav.writing')}</a>
            <a href={`/${lang}/projects/`}>{t(lang, 'nav.projects')}</a>
            <a href={`/${lang}/about/`}>{t(lang, 'nav.about')}</a>
            <a class="lang-switch" href={altPath ?? `/${otherLang}/`} rel="alternate">
              {lang === 'zh' ? 'EN' : '中文'}
            </a>
          </div>
        </nav>
        <slot name="hero" />
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          © {new Date().getFullYear()} {SITE_TITLE}{' · '}
          <a href={`/${lang}/rss.xml`}>{t(lang, 'footer.rss')}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
