---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SubscribeBox from '../../components/SubscribeBox.astro';
import SlideInSubscribe from '../../components/SlideInSubscribe.astro';
import { t, postUrl, type Lang } from '../../lib/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = post.data.lang as Lang;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const altPath = post.data.translationOf
  ? postUrl(otherLang, post.data.translationOf)
  : undefined;

const { Content } = await render(post);

const related = (await getCollection('blog', (p) =>
  p.data.lang === lang && !p.data.tags.includes('briefing') &&
  p.data.slug !== post.data.slug && p.data.slug !== 'hello-world'
))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  path={postUrl(lang, post.data.slug)}
  altPath={altPath}
>
  <article class="article">
    <header>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        {fmt.format(post.data.pubDate)}
        {altPath && (
          <>
            {' · '}
            <a class="translation-link" href={altPath} rel="alternate">
              {t(lang, 'article.translation')}
            </a>
          </>
        )}
      </div>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <div class="article-body">
      <Content />
    </div>
  </article>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString().slice(0, 10),
    inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
    author: { '@id': 'https://mengyahuustc-pu.github.io/#person' },
    mainEntityOfPage: `https://mengyahuustc-pu.github.io${postUrl(lang, post.data.slug)}`,
  })} />
  {related.length > 0 && (
    <nav class="related-posts">
      <p class="section-label">{lang === 'zh' ? '接着读' : 'Keep reading'}</p>
      <ul>
        {related.map((r) => (
          <li><a href={postUrl(lang, r.data.slug)}>{r.data.title}</a></li>
        ))}
      </ul>
    </nav>
  )}
  <SubscribeBox lang={lang} />
  <SlideInSubscribe lang={lang} />
</Base>
