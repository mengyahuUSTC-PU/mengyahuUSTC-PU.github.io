---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, postUrl, type Lang } from '../../lib/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = post.data.lang as Lang;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const altPath = post.data.translationOf
  ? postUrl(otherLang, post.data.translationOf)
  : undefined;

const { Content } = await render(post);

const fmt = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  path={postUrl(lang, post.data.slug)}
  altPath={altPath}
>
  <article class="article">
    <header>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        {fmt.format(post.data.pubDate)}
        {altPath && (
          <>
            {' · '}
            <a class="translation-link" href={altPath} rel="alternate">
              {t(lang, 'article.translation')}
            </a>
          </>
        )}
      </div>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <div class="article-body">
      <Content />
    </div>
  </article>
</Base>
