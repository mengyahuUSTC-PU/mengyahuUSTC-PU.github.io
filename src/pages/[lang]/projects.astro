---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';

const projects = [
  {
    title: lang === 'zh' ? '本站' : 'This site',
    description:
      lang === 'zh'
        ? '双语静态博客：Astro 构建，GitHub Actions 部署到 GitHub Pages。'
        : 'Bilingual static blog built with Astro, deployed to GitHub Pages via GitHub Actions.',
    tags: ['Astro', 'GitHub Pages'],
    url: 'https://github.com/mengyahuUSTC-PU/mengyahuUSTC-PU.github.io',
  },
];
---

<Base
  title={t(lang, 'projects.title')}
  description={lang === 'zh' ? '项目列表' : 'Selected projects'}
  lang={lang}
  path={`/${lang}/projects/`}
  altPath={`/${otherLang}/projects/`}
>
  <h1>{t(lang, 'projects.title')}</h1>
  <ul class="post-list">
    {projects.map((project) => (
      <li class="post-card">
        <h3>
          {project.url ? <a href={project.url}>{project.title}</a> : project.title}
        </h3>
        <p>{project.description}</p>
        <div class="tags">
          {project.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </li>
    ))}
  </ul>
</Base>
