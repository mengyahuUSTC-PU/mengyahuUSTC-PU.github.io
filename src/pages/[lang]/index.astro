---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE, t, postUrl, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';

const posts = (await getCollection('blog', (p) => p.data.lang === lang)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const deepDives = posts.filter((p) => !p.data.tags.includes('briefing'));
const briefings = posts.filter((p) => p.data.tags.includes('briefing'));

const fmt = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={SITE_TITLE}
  description={t(lang, 'home.tagline')}
  lang={lang}
  path={`/${lang}/`}
  altPath={`/${otherLang}/`}
>
  <div class="hero" slot="hero">
    {lang === 'zh' ? (
      <h1>AI <em>前沿</em>与<em>安全</em></h1>
    ) : (
      <h1>AI <em>Frontier</em> &amp; <em>Safety</em></h1>
    )}
    <p class="tagline">{t(lang, 'home.tagline')}</p>
  </div>

  <section>
    <p class="section-label">{t(lang, 'home.deepDives')}</p>
    {deepDives.length === 0 && <p>{t(lang, 'list.empty')}</p>}
    <ul class="post-list">
      {deepDives.map((post, i) => (
        <li class={`post-card${i === 0 ? ' wide' : ''}`}>
          <div class="post-meta">
            {fmt.format(post.data.pubDate)}
            {post.data.tags.length > 0 && ` · ${post.data.tags[0]}`}
          </div>
          <h3><a href={postUrl(lang, post.data.slug)}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="briefing-section">
    <p class="section-label">{t(lang, 'home.briefings')}</p>
    {briefings.length === 0 && <p>{t(lang, 'list.empty')}</p>}
    <ul class="briefing-list">
      {briefings.slice(0, 7).map((post) => (
        <li class="briefing-item">
          <span class="post-meta">{fmt.format(post.data.pubDate)}</span>
          <a href={postUrl(lang, post.data.slug)}>{post.data.title}</a>
        </li>
      ))}
    </ul>
    {briefings.length > 7 && (
      <p><a href={`/${lang}/briefing/`}>{lang === 'zh' ? '查看全部快讯 →' : 'All briefings →'}</a></p>
    )}
  </section>
</Base>
