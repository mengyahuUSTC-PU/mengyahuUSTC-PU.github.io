---
import Base from '../../layouts/Base.astro';
import SubscribeBox from '../../components/SubscribeBox.astro';
import { t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
---

<Base
  title={t(lang, 'about.title')}
  description={
    lang === 'zh'
      ? '关于胡梦雅 Mengya Hu（英文名 Mia Hu）——Responsible AI 方向的应用科学家'
      : 'About Mengya Hu (Mia Hu) — applied scientist working on Responsible AI'
  }
  lang={lang}
  path={`/${lang}/about/`}
  altPath={`/${otherLang}/about/`}
>
  <article class="article">
    <header>
      <h1>{t(lang, 'about.title')}</h1>
    </header>
    <div class="article-body">
      {lang === 'zh' ? (
        <div>
          <p>
            我是胡梦雅（Mengya Hu，英文场合常用 Mia Hu），Microsoft 高级应用科学家，在 Responsible AI
            团队工作，方向是大模型的内容安全，比如内容审核系统、幻觉检测与缓解、安全与体验的权衡设计。
          </p>
          <p>
            在此之前，我在普林斯顿大学的机械航空系攻读博士，做的是系外行星探测——为
            Starshade
            望远镜系统建仿真管线，并设计从图像中识别微弱信号的检测方法。
          </p>
          <p>我本科毕业于中国科学技术大学的热能与动力工程专业。</p>
          <p>
            从找行星到管住 AI，听起来跨度很大，但对我来说是同一件事：<strong>在巨大的噪声里，可靠地检测你关心的信号</strong>——那时是恒星光晕旁的一颗暗行星，现在是海量生成内容里的一句有害输出或一处幻觉。
          </p>
          <p>
            我对这个世界充满好奇心，对各种前沿科学技术都很有兴趣。这个博客以
            AI 前沿，行业趋势为主——偶尔也会包含别的领域。
          </p>
          <p>每篇文章中英双语。</p>
          <p>
            最近的代表作：
            <a href="/zh/ai-jobs-data-reality-check/">「AI 失业潮」在数据里几乎看不到</a>、
            <a href="/zh/chatgpt-health-hipaa-gap/">病历交给 ChatGPT 后 HIPAA 就不保护你了</a>、
            <a href="/zh/kimi-k3-open-weight-audit-gap/">3 万亿参数开源了，安全评估还在路上</a>。
          </p>
          <p>
            找到我：<a href="https://www.linkedin.com/in/mengya-mia-hu/?locale=en-US">LinkedIn</a>
            {' · '}
            <a href="https://x.com/Mengya_Mia_Hu">X</a>
          </p>
          <p>本站所有观点仅代表个人，与雇主无关。</p>
        </div>
      ) : (
        <div>
          <p>
            I'm Mengya Hu, a Senior Applied Scientist at Microsoft working
            on Responsible AI; in English settings I go by Mia Hu. My focus is LLM content safety — moderation
            systems, hallucination detection and mitigation, and the design
            trade-offs between safety and user experience.
          </p>
          <p>
            Before that, I did my Ph.D. in Mechanical and Aerospace Engineering
            at Princeton, working on exoplanet detection — building simulation
            pipelines for a starshade–telescope system and designing detection
            methods that pull faint signals out of images.
          </p>
          <p>
            I did my undergrad at USTC, in Thermal Science and Energy
            Engineering.
          </p>
          <p>
            Hunting planets and moderating AI sound worlds apart, but to me
            they're the same problem: <strong>reliably detecting the signal you
            care about inside overwhelming noise</strong> — once a dim planet
            beside a star's glare, now a harmful output or a hallucinated claim
            inside oceans of generated text.
          </p>
          <p>
            I'm endlessly curious about the world, with a broad interest in
            frontier science and technology. This blog focuses on frontier AI
            and industry trends — with occasional forays into other fields.
          </p>
          <p>Every post is published in both English and Chinese.</p>
          <p>
            Recent writing:
            <a href="/en/ai-jobs-data-reality-check/">the AI layoff wave isn't in the data</a>,
            <a href="/en/chatgpt-health-hipaa-gap/">what happens to HIPAA when your records meet ChatGPT</a>,
            and <a href="/en/kimi-k3-open-weight-audit-gap/">the Kimi K3 audit gap</a>.
          </p>
          <p>
            Find me on <a href="https://www.linkedin.com/in/mengya-mia-hu/?locale=en-US">LinkedIn</a>
            {' and '}
            <a href="https://x.com/Mengya_Mia_Hu">X</a>.
          </p>
          <p>All opinions here are my own and do not represent my employer.</p>
        </div>
      )}
    </div>
  </article>
  <SubscribeBox lang={lang} />
</Base>
