# Environment variables used by automation scripts.
# Copy to .env and fill in real values. NEVER commit .env.
# (Most of these are configured in later phases; listed here as the canonical inventory.)

# --- Phase 3: review loop ---
# DISCORD_WEBHOOK_URL=        # topic list push channel (webhook)
# DISCORD_BOT_TOKEN=          # bot token, reads user replies
# DISCORD_CHANNEL_ID=         # channel the bot polls
# GMAIL_ADDRESS=humengyahumy@gmail.com
# GMAIL_APP_PASSWORD=         # Gmail SMTP app password for report emails
# REPORT_EMAIL=humengyahumy@gmail.com

# --- Phase 4: distribution ---
# TYPEFULLY_API_KEY=          # Typefully Creator API key (Settings -> API)

# --- Phase 5: analytics ---
# GA4_PROPERTY_ID=
# GOOGLE_APPLICATION_CREDENTIALS=  # path to service account JSON (GA4 + GSC)
